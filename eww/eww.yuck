; ════════════════════════════════════════════════════════════
; Variables — deflisten (stay-alive scripts)
; ════════════════════════════════════════════════════════════

(deflisten workspaces-left :initial "[]"
  `scripts/workspaces.sh DP-2`)

(deflisten workspaces-right :initial "[]"
  `scripts/workspaces.sh DP-3`)

(deflisten window-title :initial ""
  `scripts/window.sh`)

(deflisten mpris :initial `{"status":"Stopped","title":"","artist":"","player":""}`
  `scripts/mpris.sh`)

(deflisten volume :initial `{"volume":50,"muted":false}`
  `scripts/volume.sh`)

(deflisten notifications :initial `{"count":0,"dnd":false}`
  `scripts/notifications.sh`)

; ════════════════════════════════════════════════════════════
; Variables — defpoll (interval-based)
; ════════════════════════════════════════════════════════════

(defpoll cpu :interval "2s" :initial 0
  `scripts/cpu.sh`)

(defpoll mem :interval "5s" :initial 0
  `scripts/memory.sh`)

(defpoll network :interval "5s" :initial `{"type":"disconnected"}`
  `scripts/network.sh`)

(defpoll bluetooth :interval "3s" :initial `{"status":"off"}`
  `scripts/bluetooth.sh`)

(defpoll clock-time :interval "10s"
  `date '+%H:%M'`)

(defpoll clock-date :interval "60s"
  `date '+%A, %B %d, %Y'`)

; ════════════════════════════════════════════════════════════
; State
; ════════════════════════════════════════════════════════════

(defvar clock-show-date false)

; ════════════════════════════════════════════════════════════
; Widget — Workspaces
; ════════════════════════════════════════════════════════════

(defwidget workspace-button [ws]
  (button
    :class {ws.active ? "workspace-btn active" : ws.occupied ? "workspace-btn occupied" : "workspace-btn"}
    :onclick `hyprctl dispatch split:workspace ${ws.name}`
    (label :text {ws.active ? "●" : ws.occupied ? "○" : "·"})))

(defwidget workspaces-widget [workspaces]
  (box
    :class "workspaces"
    :spacing 2
    (for ws in workspaces
      (workspace-button :ws ws))))

; ════════════════════════════════════════════════════════════
; Widget — MPRIS media
; ════════════════════════════════════════════════════════════

(defwidget mpris-widget []
  (box
    :class {mpris.status == "Playing" ? "mpris playing" : "mpris"}
    :visible {mpris.title != ""}
    (label
      :class "mpris-label"
      :text {"${mpris.title} — ${mpris.artist}"}
      :limit-width 50
      :truncate true)))

; ════════════════════════════════════════════════════════════
; Widget — Window title
; ════════════════════════════════════════════════════════════

(defwidget window-widget []
  (label
    :class "window-title"
    :text window-title
    :limit-width 60
    :truncate true))

; ════════════════════════════════════════════════════════════
; Widget — CPU
; ════════════════════════════════════════════════════════════

(defwidget cpu-widget []
  (box :class "chip"
    (label :text "󰻠 ${cpu}%")))

; ════════════════════════════════════════════════════════════
; Widget — Memory
; ════════════════════════════════════════════════════════════

(defwidget mem-widget []
  (box :class "chip"
    (label :text "󰍛 ${mem}%")))

; ════════════════════════════════════════════════════════════
; Widget — Network
; ════════════════════════════════════════════════════════════

(defwidget network-widget []
  (eventbox
    :onclick "nm-connection-editor"
    (box :class "chip"
      (label :text {
        network.type == "wifi"       ? "󰤨 ${network.name}" :
        network.type == "ethernet"   ? "󰈀 ${network.name}" :
        "󰤭 Disconnected"
      }))))

; ════════════════════════════════════════════════════════════
; Widget — Bluetooth
; ════════════════════════════════════════════════════════════

(defwidget bluetooth-widget []
  (eventbox
    :onclick "blueman-manager"
    (box :class {bluetooth.status == "connected" ? "chip bt-connected" : "chip"}
      (label :text {
        bluetooth.status == "off"       ? "󰂲" :
        bluetooth.status == "connected" ? "󰂱 ${bluetooth.device}" :
        "󰂯"
      }))))

; ════════════════════════════════════════════════════════════
; Widget — Volume
; ════════════════════════════════════════════════════════════

(defwidget volume-widget []
  (eventbox
    :onclick "pavucontrol"
    :onscroll "scripts/volume-scroll.sh {}"
    (box :class {volume.muted ? "chip vol-muted" : "chip"}
      (label :text {
        volume.muted         ? "󰝟 Muted" :
        volume.volume < 30   ? "󰕿 ${volume.volume}%" :
        volume.volume < 70   ? "󰖀 ${volume.volume}%" :
        "󰕾 ${volume.volume}%"
      }))))

; ════════════════════════════════════════════════════════════
; Widget — Clock
; ════════════════════════════════════════════════════════════

(defwidget clock-widget []
  (eventbox
    :onclick "eww update clock-show-date=${!clock-show-date}"
    :onrightclick "gnome-calendar"
    (box :class "chip clock"
      (label :text {clock-show-date ? "󰥔 ${clock-date}" : "󰥔 ${clock-time}"}))))

; ════════════════════════════════════════════════════════════
; Widget — Notifications (swaync)
; ════════════════════════════════════════════════════════════

(defwidget notification-widget []
  (eventbox
    :onclick "swaync-client -t -sw"
    :onrightclick "swaync-client -d -sw"
    (box :class "chip notif"
      (label :text {
        notifications.dnd             ? "󰂛" :
        notifications.count > 0       ? "󰂚" :
        "󰂜"
      }))))

; ════════════════════════════════════════════════════════════
; Widget — Power
; ════════════════════════════════════════════════════════════

(defwidget power-widget []
  (eventbox
    :onclick "wlogout"
    (box :class "chip power"
      (label :text "󰐥"))))

; ════════════════════════════════════════════════════════════
; Widget — Bar layout (shared by both monitors)
; ════════════════════════════════════════════════════════════

(defwidget bar [workspaces]
  (centerbox :orientation "h" :class "bar-inner"
    ; Left: workspaces + media
    (box :halign "start" :class "modules-left" :spacing 4
      (workspaces-widget :workspaces workspaces)
      (mpris-widget))
    ; Center: active window title
    (box :halign "center" :class "modules-center"
      (window-widget))
    ; Right: system chips + tray
    (box :halign "end" :class "modules-right" :spacing 2
      (cpu-widget)
      (mem-widget)
      (network-widget)
      (bluetooth-widget)
      (volume-widget)
      (clock-widget)
      (notification-widget)
      (power-widget)
      (systray :class "tray" :spacing 8))))

; ════════════════════════════════════════════════════════════
; Windows — one per monitor
; ════════════════════════════════════════════════════════════

(defwindow bar-dp2
  :monitor "DP-2"
  :geometry (geometry
    :x "0px" :y "0px"
    :width "100%" :height "30px"
    :anchor "top center")
  :stacking "fg"
  :exclusive true
  :namespace "eww-bar"
  (bar :workspaces workspaces-left))

(defwindow bar-dp3
  :monitor "DP-3"
  :geometry (geometry
    :x "0px" :y "0px"
    :width "100%" :height "30px"
    :anchor "top center")
  :stacking "fg"
  :exclusive true
  :namespace "eww-bar"
  (bar :workspaces workspaces-right))
